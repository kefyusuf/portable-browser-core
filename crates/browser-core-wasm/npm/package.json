{
  "name": "portable-browser-core",
  "version": "0.1.0",
  "description": "Platform-independent browser decision core: deterministic navigation resolution, tab lifecycle, session history, and window sets (WASM bridge)",
  "main": "nodejs/browser_core_wasm.js",
  "types": "nodejs/browser_core_wasm.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./nodejs/browser_core_wasm.d.ts",
        "default": "./nodejs/browser_core_wasm.js"
      },
      "bundler": {
        "types": "./bundler/browser_core_wasm.d.ts",
        "default": "./bundler/browser_core_wasm.js"
      },
      "default": {
        "types": "./web/browser_core_wasm.d.ts",
        "default": "./web/browser_core_wasm.js"
      }
    }
  },
  "files": [
    "nodejs/",
    "bundler/",
    "web/"
  ],
  "license": "MIT",
  "keywords": [
    "wasm",
    "browser",
    "tab",
    "navigation",
    "agent",
    "llm"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kefyusuf/portable-browser-core"
  },
  "bugs": {
    "url": "https://github.com/kefyusuf/portable-browser-core/issues"
  },
  "homepage": "https://github.com/kefyusuf/portable-browser-core#readme"
}
